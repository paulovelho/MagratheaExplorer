{
	"name": "platypustechnology/magratheaexplorer",
	"description": "Magrathea Explorer",
	"require": {
		"symfony/http-client": "^6.4",
		"nyholm/psr7": "^1.8",
		"async-aws/s3": "^3.4",
		"james-heinrich/getid3": "^1.9",
		"platypustechnology/magratheaphp": "^3.0"
	},
	"config": {
		"allow-plugins": {
			"php-http/discovery": true
		}
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5"
	},
	"extra": {
		"magrathea": {
			"bootstrap": "src/_inc.php"
		}
	}
}
