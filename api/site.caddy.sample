# Caddy equivalent of api/src/.htaccess + the vhost `scripts/deploy.sh vhost` prints.
# Copy it to api/src/site.caddy (gitignored, like the .conf files): that's
# MagratheaPHP's appRoot, where the framework admin's "site.caddy" page reads it
# from. It's never served from there (see @caddyfile below, and the matching
# <FilesMatch> deny in .htaccess).
#
# Paths match the layout in docs/deploy.md -- change the hostname, the two roots
# and the php_fastcgi socket for your server. If this domain also serves other,
# unrelated tools/paths outside this repo, fold these `handle` blocks into that
# shared site address block instead of running this as its own -- Caddy won't let
# two site blocks both claim the same hostname.

files.example.com {
	root * /var/www/explorer/api/src

	# Dotfiles (.htaccess, .user.ini -- both here and in local storage) and this
	# file itself. Has to be a `handle`, not a bare `respond`: Caddy runs `handle`
	# before `respond`, so the catch-all handle below would serve them first.
	# .well-known stays reachable for ACME and friends. Caddy's file_server never
	# lists directories, so no Options -Indexes equivalent is needed.
	@private {
		path_regexp /\.
		not path /.well-known/*
	}
	@caddyfile path /site.caddy
	handle @private {
		respond 403
	}
	handle @caddyfile {
		respond 403
	}

	# Root has nothing of its own -- send visitors to the admin app instead
	# of falling through to php_fastcgi (which would dispatch it into the
	# API router with no matching route). Exact match only, so admin.php and
	# everything else below is untouched. Mirrors the same rule in
	# api/src/.htaccess.
	@root path /
	redir @root /app/ 302

	# Only requests under /api/v1/... reach the JSON API router; everything
	# else (admin.php, error-manager assets, etc.) falls through to the
	# default handle below and is served/executed as a normal file.
	# Bump this prefix (v1 -> v2) the day the route table needs a breaking
	# change -- mirrors the same comment in api/src/.htaccess.
	@apiv1 path_regexp apiv1 ^/api/v1/(.*)$
	handle @apiv1 {
		# index.php reads magrathea_control/action/params from $_GET and just
		# rejoins them with "/" before re-splitting on "/" -- unlike the
		# .htaccess version (which mod_rewrite forced into three separate
		# 1/2/3-segment rules), there's no need to split the captured path
		# across control/action/params here: dumping it all into
		# magrathea_control and leaving action/params unset reconstructs the
		# exact same segment list once index.php explodes and array_filters
		# it. {http.request.uri.query} preserves real GET filters
		# (?folder_id=5 etc.), same job as .htaccess's %{QUERY_STRING}/%1.
		rewrite * /index.php?magrathea_control={re.apiv1.1}&{http.request.uri.query}
		php_fastcgi unix//run/php/php8.4-fpm.sock
	}

	# storage.conf's local_path lives outside api/src's docroot -- route it
	# here so local_url (.../storage) resolves. Drop this block on s3/R2 instances.
	#
	# No PHP in this read path (see StorageAdapter docs), so LocalStorageAdapter::url()
	# smuggles the download name in as ?disposition=&filename= and this block turns
	# that into the real Content-Disposition header -- Apache-side equivalent is
	# api/storage/.htaccess. filename is already reduced to [A-Za-z0-9._-] on the PHP
	# side, so the raw (already-decoded-by-Caddy) placeholder value is safe to drop
	# straight into the header with no extra encoding/decoding of our own.
	handle_path /storage/* {
		root * /var/www/explorer-storage
		# Same job as the vhost's nosniff header: browsers mustn't second-guess a
		# user-uploaded file's Content-Type into something more dangerous.
		header X-Content-Type-Options nosniff
		@download `{http.request.uri.query.filename} != ''`
		header @download Content-Disposition "{http.request.uri.query.disposition}; filename=\"{http.request.uri.query.filename}\""
		file_server
	}

	# Admin app (Vue 3 + Vite): api/src/app is a committed symlink to the
	# repo-root dist/ (Vite's build output), served at /app, sibling to the
	# versioned JSON API at /api/v1. Real files (hashed assets, favicons) are
	# served statically; everything else -- /app/ itself, index.html, and any
	# vue-router history-mode path like /app/folder/42 -- goes to
	# api/src/app-index.php, which serves index.html with ConfigApp's
	# app_name injected and lets the router take over client-side. Paths
	# ending in "/" are excluded from @appStatic so /app/ can't match the
	# directory and get served the raw index.html template. Mirrors
	# app/public/.htaccess (copied into dist/ at build time).
	@appStatic {
		path /app/*
		not path */
		not path /app/index.html
		file
	}
	handle @appStatic {
		file_server
	}
	@app path /app /app/*
	handle @app {
		rewrite * /app-index.php
		php_fastcgi unix//run/php/php8.4-fpm.sock
	}

	# Default: anything not matched above (admin.php, direct .php class
	# files, static assets) is executed/served straight from api/src, same
	# as Apache's `RewriteCond %{REQUEST_FILENAME} -f` passthrough.
	handle {
		php_fastcgi unix//run/php/php8.4-fpm.sock
		file_server
	}
}
